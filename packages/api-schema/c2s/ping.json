{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livachat.dev/schemas/c2s/ping.json",
  "title": "ping — Client Heartbeat",
  "description": "Client sends a ping every 15 seconds for keepalive. Server replies with pong. If server receives no messages for 35s, it closes the connection (code 4002).",
  "type": "object",
  "required": ["type", "seq", "timestamp", "payload"],
  "properties": {
    "type": {
      "const": "ping"
    },
    "seq": {
      "$ref": "../common.json#/$defs/SeqNumber"
    },
    "timestamp": {
      "$ref": "../common.json#/$defs/Timestamp"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "description": "Empty payload for client ping."
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "type": "ping",
      "seq": 60,
      "timestamp": 1712345685000,
      "payload": {}
    }
  ]
}
