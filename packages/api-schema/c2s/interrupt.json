{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livachat.dev/schemas/c2s/interrupt.json",
  "title": "interrupt — Interrupt AI Output",
  "description": "Client interrupts the current AI speaking turn. Must be sent BEFORE subsequent audio frames. Critical timing: client should flush the WebSocket write buffer immediately after sending this message.",
  "type": "object",
  "required": ["type", "seq", "timestamp", "payload"],
  "properties": {
    "type": {
      "const": "interrupt"
    },
    "seq": {
      "$ref": "../common.json#/$defs/SeqNumber"
    },
    "timestamp": {
      "$ref": "../common.json#/$defs/Timestamp"
    },
    "payload": {
      "type": "object",
      "required": ["reason"],
      "properties": {
        "reason": {
          "$ref": "../common.json#/$defs/InterruptReason"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "type": "interrupt",
      "seq": 58,
      "timestamp": 1712345683000,
      "payload": {
        "reason": "user_voice"
      }
    }
  ]
}
