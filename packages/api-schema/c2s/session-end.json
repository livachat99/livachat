{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livachat.dev/schemas/c2s/session-end.json",
  "title": "session.end — End Session",
  "description": "Client gracefully ends the current session. Server will clean up session context and reply with session.ended.",
  "type": "object",
  "required": ["type", "seq", "timestamp", "payload"],
  "properties": {
    "type": {
      "const": "session.end"
    },
    "seq": {
      "$ref": "../common.json#/$defs/SeqNumber"
    },
    "timestamp": {
      "$ref": "../common.json#/$defs/Timestamp"
    },
    "payload": {
      "type": "object",
      "required": ["reason"],
      "properties": {
        "reason": {
          "$ref": "../common.json#/$defs/SessionEndReason"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "type": "session.end",
      "seq": 145,
      "timestamp": 1712345778000,
      "payload": {
        "reason": "user_quit"
      }
    }
  ]
}
