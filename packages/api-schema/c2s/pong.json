{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livachat.dev/schemas/c2s/pong.json",
  "title": "pong — Client Heartbeat Reply",
  "description": "Client replies to a server ping. Must respond within 3 seconds.",
  "type": "object",
  "required": ["type", "seq", "timestamp", "payload"],
  "properties": {
    "type": {
      "const": "pong"
    },
    "seq": {
      "$ref": "../common.json#/$defs/SeqNumber"
    },
    "timestamp": {
      "$ref": "../common.json#/$defs/Timestamp"
    },
    "payload": {
      "type": "object",
      "required": ["ping_seq"],
      "properties": {
        "ping_seq": {
          "$ref": "../common.json#/$defs/UInt32",
          "description": "Echoes the seq number of the server's ping message."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "type": "pong",
      "seq": 61,
      "timestamp": 1712345685100,
      "payload": {
        "ping_seq": 2001
      }
    }
  ]
}
