{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livachat.dev/schemas/s2c/ping.json",
  "title": "ping — Server Heartbeat",
  "description": "Server sends a ping to probe client liveness. Client must reply with pong within 3 seconds. Server typically sends this when it has not received a client ping within the keepalive window.",
  "type": "object",
  "required": ["type", "seq", "timestamp", "payload"],
  "properties": {
    "type": {
      "const": "ping"
    },
    "seq": {
      "$ref": "../common.json#/$defs/SeqNumber"
    },
    "timestamp": {
      "$ref": "../common.json#/$defs/Timestamp"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "description": "Empty payload for server ping."
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "type": "ping",
      "seq": 100,
      "timestamp": 1712345689000,
      "payload": {}
    }
  ]
}
