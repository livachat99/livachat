{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livachat.dev/schemas/s2c/pong.json",
  "title": "pong — Server Heartbeat Reply",
  "description": "Server replies to a client ping with a pong, echoing the client's ping seq number for RTT measurement.",
  "type": "object",
  "required": ["type", "seq", "timestamp", "payload"],
  "properties": {
    "type": {
      "const": "pong"
    },
    "seq": {
      "$ref": "../common.json#/$defs/SeqNumber"
    },
    "timestamp": {
      "$ref": "../common.json#/$defs/Timestamp"
    },
    "payload": {
      "type": "object",
      "required": ["ping_seq"],
      "properties": {
        "ping_seq": {
          "$ref": "../common.json#/$defs/UInt32",
          "description": "Echoes the seq number of the client's ping message."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "type": "pong",
      "seq": 101,
      "timestamp": 1712345689100,
      "payload": {
        "ping_seq": 60
      }
    }
  ]
}
