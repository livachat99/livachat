{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livachat.dev/schemas/s2c/ai-text.json",
  "title": "ai_text — LLM Streaming Text",
  "description": "Server streams LLM-generated text chunks to the client. Chunks sharing the same message_id belong to one AI reply. Client should display incrementally and finalize when is_final=true. When is_final=true and video is enabled, the image field carries the camera frame that was shown to the LLM.",
  "type": "object",
  "required": ["type", "seq", "timestamp", "payload"],
  "properties": {
    "type": {
      "const": "ai_text"
    },
    "seq": {
      "$ref": "../common.json#/$defs/SeqNumber"
    },
    "timestamp": {
      "$ref": "../common.json#/$defs/Timestamp"
    },
    "payload": {
      "type": "object",
      "required": ["text", "message_id", "index", "is_final"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 0,
          "description": "LLM text fragment. May be empty for the first chunk."
        },
        "message_id": {
          "$ref": "../common.json#/$defs/MessageId"
        },
        "index": {
          "$ref": "../common.json#/$defs/UInt32",
          "description": "Zero-based chunk index within this message. Increments monotonically per message_id."
        },
        "is_final": {
          "type": "boolean",
          "description": "true = this is the last text chunk for this message_id."
        },
        "source": {
          "type": "string",
          "enum": ["llm", "agent"],
          "description": "Origin of this message. Absent = \"llm\" (backward compatible)."
        },
        "reply_to": {
          "type": "string",
          "description": "For agent replies: transcription_id of the user utterance this answers."
        },
        "agent_name": {
          "type": "string",
          "description": "When source=\"agent\": identifies which agent produced this message."
        },
        "proactive": {
          "type": "boolean",
          "description": "Whether this is a proactive push (not in response to a user utterance)."
        },
        "image": {
          "type": "object",
          "required": ["data", "mime", "width", "height", "orientation", "camera_facing"],
          "properties": {
            "data": {
              "type": "string",
              "minLength": 1,
              "description": "Base64-encoded JPEG image data. Only present when is_final=true and video is enabled."
            },
            "mime": {
              "type": "string",
              "const": "image/jpeg"
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "description": "Original image width in pixels."
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "description": "Original image height in pixels."
            },
            "orientation": {
              "$ref": "../common.json#/$defs/Orientation"
            },
            "camera_facing": {
              "$ref": "../common.json#/$defs/CameraFacing"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "type": "ai_text",
      "seq": 30,
      "timestamp": 1712345684000,
      "payload": {
        "text": "今天天气确实",
        "message_id": "msg_xyz789abcdef",
        "index": 1,
        "is_final": false
      }
    },
    {
      "type": "ai_text",
      "seq": 35,
      "timestamp": 1712345686000,
      "payload": {
        "text": "我看到桌子上有一杯咖啡和一个红色的杯子。",
        "message_id": "msg_abc123",
        "index": 5,
        "is_final": true,
        "image": {
          "data": "/9j/4AAQSkZJRg...base64...",
          "mime": "image/jpeg",
          "width": 1080,
          "height": 1920,
          "orientation": 270,
          "camera_facing": "front"
        }
      }
    }
  ]
}
