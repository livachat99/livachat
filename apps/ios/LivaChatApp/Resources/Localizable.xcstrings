    "webview_load_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The page could not be loaded. Check the connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面加载失败，请检查连接后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頁面載入失敗，請檢查網路後重試"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページを読み込めませんでした。ネットワークを確認して再試行してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지를 불러오지 못했어요. 네트워크를 확인하고 다시 시도해 주세요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить страницу. Проверьте сеть и повторите попытку"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seite konnte nicht geladen werden. Netzwerk prüfen und erneut versuchen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec du chargement de la page. Vérifiez le réseau et réessayez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare la pagina. Controlla la rete e riprova"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar la página. Comprueba la red y vuelve a intentarlo"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar a página. Verifique a rede e tente novamente"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेज लोड नहीं हो सका। नेटवर्क जाँचें और पुनः प्रयास करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman gagal dimuat. Periksa jaringan dan coba lagi"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل تحميل الصفحة. تحقق من الشبكة وأعد المحاولة."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดหน้าไม่สำเร็จ ตรวจสอบเครือข่ายแล้วลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tải được trang. Kiểm tra mạng và thử lại."
          }
        }
