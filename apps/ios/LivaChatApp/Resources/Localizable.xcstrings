    "perm_camera_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So I can see your surroundings — you can turn it on later"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让我看见你的周围环境，需要时再打开也可以"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓我看見你的周圍環境，需要時再開啟也可以"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "周りの様子を見せてください。後からオンにすることもできます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변 환경을 볼 수 있어요. 나중에 필요할 때 켜도 돼요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы видеть, что вас окружает. Можно включить позже"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit ich Ihre Umgebung sehen kann. Kann später aktiviert werden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour voir ce qui vous entoure. Activable plus tard"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per vedere ciò che ti circonda. Puoi attivarla più tardi"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver lo que te rodea. Puedes activarla más tarde"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver o que está ao seu redor. Você pode ativá-la depois"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके आसपास देखने के लिए। बाद में चालू कर सकते हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk melihat sekitar Anda. Bisa dinyalakan nanti"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لأرى محيطك — يمكنك فتحها لاحقًا"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อให้ฉันมองเห็นสภาพแวดล้อมของคุณ — เปิดภายหลังได้"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để tôi có thể nhìn thấy môi trường xung quanh — bạn có thể bật sau"
          }
        }
      }
    },
