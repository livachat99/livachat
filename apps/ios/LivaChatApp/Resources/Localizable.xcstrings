    "conv_welcome_subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm your AI companion — chat with me anytime."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我是你的 AI 伙伴，随时可以和我聊天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我是你的 AI 夥伴，隨時可以和我聊天"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私はあなたの AI パートナーです。いつでも話しかけてくださいね"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
