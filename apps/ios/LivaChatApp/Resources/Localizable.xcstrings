    "ai_generated_notice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversation content is AI-generated. Please evaluate it carefully."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话内容有AI生成，请仔细鉴别."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話內容有AI生成，請仔細鑑別."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話内容はAIによって生成されています。慎重に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화 내용은 AI가 생성합니다. 신중하게 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое диалога создано ИИ. Пожалуйста, оценивайте его внимательно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesprächsinhalte werden von KI generiert. Bitte prüfen Sie sie sorgfältig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu de la conversation est généré par IA. Veuillez l’évaluer attentivement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenuto della conversazione è generato dall'IA. Valutalo con attenzione."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido de la conversación es generado por IA. Evalúalo con atención."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo da conversa é gerado por IA. Avalie com atenção."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बातचीत की सामग्री AI द्वारा जनरेट की गई है। कृपया इसे ध्यान से जाँचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten percakapan dihasilkan oleh AI. Harap evaluasi dengan cermat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محتوى المحادثة مُنشأ بواسطة الذكاء الاصطناعي. يرجى تقييمه بعناية."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เนื้อหาการสนทนาสร้างโดย AI โปรดตรวจสอบอย่างรอบคอบ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung cuộc trò chuyện được tạo bởi AI. Vui lòng đánh giá cẩn thận."
          }
        }
      }
    },
