    "conv_camera_permission_guide": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera permission is required to use the camera. Check LivaChat's camera permission in system settings and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相机功能需要相机权限。请检查 LivaChat 的相机权限设置后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相機功能需要相機權限。請檢查 LivaChat 的相機權限設定後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ機能を使うにはカメラの権限が必要です。LivaChat のカメラ権限の設定を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 기능을 사용하려면 카메라 권한이 필요해요. 시스템 설정에서 LivaChat의 카메라 권한을 확인한 뒤 다시 시도해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для работы камеры нужно разрешение. Проверьте разрешение камеры для LivaChat в настройках системы и повторите попытку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Kameranutzung ist die Kamera-Berechtigung erforderlich. Prüfen Sie die Berechtigung für LivaChat in den Systemeinstellungen und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation caméra est requise pour utiliser la caméra. Vérifiez l'autorisation de LivaChat dans les paramètres système, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per usare la fotocamera serve l'autorizzazione. Controlla l'autorizzazione per LivaChat nelle impostazioni di sistema e riprova."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar la cámara se necesita el permiso de cámara. Comprueba el permiso de LivaChat en los ajustes del sistema y vuelve a intentarlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar a câmera, é necessária a permissão de câmera. Verifique a permissão do LivaChat nas configurações do sistema e tente novamente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा इस्तेमाल करने के लिए कैमरे की अनुमति चाहिए। सिस्टम सेटिंग्स में LivaChat की कैमरा अनुमति जाँचें और फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin kamera diperlukan untuk menggunakan kamera. Periksa izin kamera LivaChat di setelan sistem lalu coba lagi."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم إذن الكاميرا لاستخدام الكاميرا. تحقق من إذن الكاميرا لتطبيق LivaChat في إعدادات النظام وأعد المحاولة."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องอนุญาตการใช้กล้องก่อนจึงจะใช้กล้องได้ ตรวจสอบสิทธิ์กล้องของ LivaChat ในการตั้งค่าระบบแล้วลองอีกครั้ง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần quyền sử dụng camera để dùng camera. Kiểm tra quyền camera của LivaChat trong cài đặt hệ thống và thử lại."
          }
        }
      }
    },
