          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بشهادة موقّعة ذاتيًا"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตใบรับรองที่ลงนามเอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép chứng chỉ tự ký"
          }
        }
      }
    },
    "settings_tls_allow_self_signed_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only for trusted local servers. Disables certificate verification."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于可信的本地服务器，会关闭证书校验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅供受信任的區域網路伺服器使用。會停用憑證驗證。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼できるローカルサーバー専用です。証明書の検証が無効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰할 수 있는 로컬 서버에서만 사용하세요. 인증서 검증이 비활성화돼요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для доверенных локальных серверов. Отключает проверку сертификата."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für vertrauenswürdige lokale Server. Deaktiviert die Zertifikatsprüfung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour les serveurs locaux de confiance. Désactive la vérification du certificat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo per server locali affidabili. Disattiva la verifica del certificato."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para servidores locales de confianza. Desactiva la verificación del certificado."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas para servidores locais confiáveis. Desativa a verificação do certificado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल भरोसेमंद स्थानीय सर्वर के लिए। प्रमाणपत्र सत्यापन बंद करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya untuk server lokal terpercaya. Menonaktifkan verifikasi sertifikat."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لخوادم محلية موثوقة فقط. يعطّل التحقق من الشهادة."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เฉพาะกับเซิร์ฟเวอร์ภายในที่เชื่อถือได้ จะปิดการตรวจสอบใบรับรอง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dành cho máy chủ nội bộ đáng tin cậy. Tắt xác minh chứng chỉ."
          }
        }
      }
    },
