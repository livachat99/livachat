    "settings_apply_confirm_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current conversation will end and the app will reconnect with the new server settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前会话将结束，并使用新的服务器配置重新连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前的對話將結束，App 會使用新的伺服器設定重新連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の会話は終了し、新しいサーバー設定でアプリが再接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 대화가 종료되고 새 서버 설정으로 앱이 다시 연결돼요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущий разговор завершится, и приложение переподключится с новыми настройками сервера."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aktuelle Gespräch wird beendet und die App verbindet sich mit den neuen Servereinstellungen neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversation actuelle va se terminer et l’app se reconnectera avec les nouveaux réglages du serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversazione attuale terminerà e l’app si riconnetterà con le nuove impostazioni del server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversación actual finalizará y la aplicación se reconectará con la nueva configuración del servidor."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A conversa atual será encerrada e o app se reconectará com as novas configurações do servidor."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा बातचीत समाप्त हो जाएगी और ऐप नई सर्वर सेटिंग के साथ फिर से कनेक्ट होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Percakapan saat ini akan berakhir dan aplikasi akan menyambung ulang dengan pengaturan server baru."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستنتهي المحادثة الحالية وسيعيد التطبيق الاتصال بإعدادات الخادم الجديدة."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บทสนทนาปัจจุบันจะสิ้นสุด และแอปจะเชื่อมต่อใหม่ด้วยการตั้งค่าเซิร์ฟเวอร์ใหม่"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện hiện tại sẽ kết thúc và ứng dụng sẽ kết nối lại với cài đặt máy chủ mới."
          }
        }
      }
    },
