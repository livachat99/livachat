          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я ваш ИИ-компаньон. Общайтесь со мной в любое время"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin Ihr KI-Begleiter. Sprechen Sie jederzeit mit mir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je suis votre compagnon IA. Parlez-moi quand vous voulez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono il tuo compagno IA. Parlami quando vuoi"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soy tu compañero de IA. Habla conmigo cuando quieras"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sou seu companheiro de IA. Fale comigo quando quiser"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं आपका AI साथी हूँ। जब चाहें मुझसे बात करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
