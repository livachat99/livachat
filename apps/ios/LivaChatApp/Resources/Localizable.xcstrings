    "conv_server_config_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please enter the server address and auth key in Settings first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在设置中填写服务器地址与认证密钥。"
