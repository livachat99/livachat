# LivaChat Server + LiveKit Server on one public TLS port.
#
# SAMPLE — copy this file, adjust the placeholders/paths, then run nginx -t.
#
# Target:
#   public 8060/TCP -> nginx 8444/TLS
#     /rtc*                  -> http://127.0.0.1:7880   LiveKit signaling (WSS)
#     everything else        -> http://127.0.0.1:8080   LivaChat Server
#
# Install:
#   Copy this file into nginx's `servers/` include directory (or include it
#   from inside `http {}`) and run `nginx -t` before reloading.
# After cutover, remove the legacy `listen 8443 ssl` LiveKit server block from nginx.conf
# and retire the external 8061 port mapping.
#
# Assumptions:
#   - <server-host> is the DNS name covered by the certificate below.
#   - The main nginx config includes this file from inside `http {}` and defines the
#     `map $http_upgrade $connection_upgrade { ... }` block.
#   - Current LivaChat config has server.ssl.enabled=false, so upstream is http.
#     If server TLS is enabled, replace every http://127.0.0.1:8080 below with
#     https://127.0.0.1:8080 and uncomment proxy_ssl_verify/proxy_ssl_protocols.
#   - LiveKit keeps its current plain-HTTP listener on 127.0.0.1:7880.
#
# This single port carries HTTPS API + WSS signaling only. LiveKit WebRTC media still
# needs UDP 50000-60000 and TCP 7881 (or a TURN/TLS setup) exposed separately.

# http-context directive: this file must be included from inside http {} (servers/* is).
# $uri intentionally excludes the query string: token/device_id must not enter access logs.
log_format livachat_livekit_noargs '$remote_addr - $remote_user [$time_local] '
                                   '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                                   '"$http_referer" "$http_user_agent"';

server {
    listen 8444 ssl;
    # HTTP/2 is intentionally left off for the first cutover: this listener carries two
    # WebSocket endpoints, and nginx's WebSocket-over-HTTP/2 (RFC 8441) support is not
    # relied on here. Enable only after verifying both WSS endpoints.
    # http2 on;
    server_name <server-host>;

    # Relative paths; replace with the certificate/key paths for your deployment.
    ssl_certificate     cert.pem;
    ssl_certificate_key key.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:livachat_livekit_ssl:10m;
    ssl_session_timeout 1d;
    ssl_prefer_server_ciphers off;

    client_max_body_size 10m;

    # Common upstream headers for normal HTTP requests. WebSocket locations below repeat
    # these explicitly and add Upgrade/Connection: once a location declares any
    # proxy_set_header, nginx no longer inherits the server-level header directives.
    # Keep the external Host (including 8060) so /meeting's 307 does not lose the port.
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;

    proxy_connect_timeout 5s;
    proxy_read_timeout 65s;
    proxy_send_timeout 65s;

    # If the LivaChat upstream uses TLS (server.ssl.enabled=true), uncomment:
    # proxy_ssl_verify off;
    # proxy_ssl_protocols TLSv1.2 TLSv1.3;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/json
        application/javascript
        application/xml
        image/svg+xml
        application/wasm;

    # Relative path; adjust for your nginx prefix or use `access_log off;`.
    access_log logs/livachat_livekit.access.log livachat_livekit_noargs;

    # ---------------- LiveKit signaling ----------------
    # Reserve /rtc and /rtc/...; LiveKit's client appends /rtc to the configured wss URL.
    # No LivaChat route starts with /rtc.
    location ^~ /rtc {
        proxy_pass http://127.0.0.1:7880;

        # Repeated because location-level proxy_set_header disables server-level inheritance.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_buffering off;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # ---------------- LivaChat WebSocket ----------------
    location = /v1/ws/stream {
        proxy_pass http://127.0.0.1:8080;

        # Repeated because location-level proxy_set_header disables server-level inheritance.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ---------------- Health ----------------
    location = /healthz {
        proxy_pass http://127.0.0.1:8080;
    }

    location = /readyz {
        proxy_pass http://127.0.0.1:8080;
    }

    location = /healthz_token {
        proxy_pass http://127.0.0.1:8080;
    }

    # ---------------- Media / Range ----------------
    location ^~ /api/mylife/media/ {
        proxy_pass http://127.0.0.1:8080;

        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # ---------------- BFF / API ----------------
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8080;
    }

    # ---------------- Agent webroot ----------------
    location ^~ /webroot/ {
        proxy_pass http://127.0.0.1:8080;
    }

    # ---------------- Meeting SPA ----------------
    location = /meeting/config.json {
        proxy_pass http://127.0.0.1:8080;

        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /meeting/assets/ {
        proxy_pass http://127.0.0.1:8080;

        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location ^~ /meeting/vendor/mediapipe/ {
        proxy_pass http://127.0.0.1:8080;

        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # /meeting/ and /meeting/<meeting-number> both serve the SPA.
    location ^~ /meeting/ {
        proxy_pass http://127.0.0.1:8080;

        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-cache" always;
    }

    # /meeting without the trailing slash: let the backend issue its 307.
    location = /meeting {
        proxy_pass http://127.0.0.1:8080;
    }

    # ---------------- Fallback ----------------
    location / {
        proxy_pass http://127.0.0.1:8080;
    }
}
