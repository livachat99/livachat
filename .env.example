# Usage: cp .env.example .env
# After copying, fill in the required fields, then start the server with ./livachat.sh start
# NEVER commit .env (.gitignore already ignores /.env).
#

# ==================== 1. Required settings ====================

# Alibaba Bailian provider API key (per-region: keys cannot be shared across regions)
# International site (Model Studio):
#   https://modelstudio.console.alibabacloud.com/
# China site (Bailian console):
#   https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=

# API Host: the raw value of the API Host column on the alibaba console's Workspace Management page (domain only)
DASHSCOPE_API_HOST=llm-xxxx.cn-beijing.maas.aliyuncs.com

# Workspace ID: the Workspace ID on the alibaba console's Workspace Management page
DASHSCOPE_WORKSPACE_ID=llm-xxxx

# Auth token for the LivaChat app to connect to the LivaChat server.
# Enter this value in the app settings to establish a connection.
APP_AUTH_TOKEN=

# OpenClaw gateway token
# From gateway.auth.token in ~/.openclaw/openclaw.json
# Can be left empty if OpenClaw is not connected, but the variable line must exist—a missing line causes startup to fail
OPENCLAW_AUTH_TOKEN=

# Hermes Dashboard SESSION_TOKEN
# The HERMES_DASHBOARD_SESSION_TOKEN preset when `hermes serve` starts, from ~/.hermes/.env
# Can be left empty if Hermes is not connected—but the variable line must exist, or startup fails
HERMES_AUTH_TOKEN=


# ==================== 2. LIVACHAT__ overrides (optional) ====================

# Auth (dev mode)
# LIVACHAT__AUTH__MODE=dev

# ASR providers
# LIVACHAT__ASR__PROVIDERS__DEEPGRAM__API_KEY=
# LIVACHAT__ASR__PROVIDERS__ELEVENLABS__API_KEY=
# LIVACHAT__ASR__PROVIDERS__ALIBABA_BAILIAN__API_KEY=
# LIVACHAT__ASR__PROVIDERS__ALIBABA_BAILIAN__MODEL=paraformer-realtime-v2

# LLM providers
# LIVACHAT__LLM__PROVIDERS__ALIBABA_BAILIAN__API_KEY=
# LIVACHAT__LLM__PROVIDERS__OPENROUTER__API_KEY=
# LIVACHAT__LLM__PROVIDERS__DEEPSEEK__API_KEY=

# TTS providers
# LIVACHAT__TTS__PROVIDERS__DEEPGRAM__API_KEY=
# LIVACHAT__TTS__PROVIDERS__ELEVENLABS__API_KEY=
# LIVACHAT__TTS__PROVIDERS__ALIBABA_BAILIAN__API_KEY=
# LIVACHAT__TTS__PROVIDERS__CARTESIA__API_KEY=

# --- SSL/TLS (optional) ---
# LIVACHAT__SERVER__SSL__ENABLED=true
# LIVACHAT__SERVER__SSL__CERTFILE=/path/to/cert.pem
# LIVACHAT__SERVER__SSL__KEYFILE=/path/to/key.pem
# LIVACHAT__SERVER__SSL__KEYFILE_PASSWORD=
# LIVACHAT__SERVER__SSL__CAFILE=
# LIVACHAT__SERVER__SSL__CERT_REQS=none
